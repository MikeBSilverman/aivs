# =============================================================================
# AIVS deployment environment.
#
#     cp deploy/env.example deploy/.env
#     chmod 0600 deploy/.env
#     $EDITOR deploy/.env
#     docker compose --env-file deploy/.env up -d
#
# deploy/.env is git-ignored by the `.env` pattern in .gitignore. This example
# is not, and MUST NEVER contain a real value -- not a "temporary" one, not a
# development one. Every placeholder below is obviously a placeholder on
# purpose, so that a committed real secret stands out in review.
#
# WHY AN ENV FILE AND NOT DOCKER SECRETS. Docker secrets appear as files under
# /run/secrets, and pydantic-settings reads the environment, so using them for
# the application would mean either a wrapper entrypoint that exports file
# contents (which puts the secret back in the environment anyway, one process
# later) or a code change to add *_FILE support. One mechanism, applied
# consistently and with correct file permissions, is easier to audit than two
# that overlap. On Swarm or Kubernetes, mount these as a secret-backed env
# source; the variable names do not change.
#
# The application reads AIVS_* variables directly (env_prefix = "AIVS_" in
# aivs_server.config), and refuses to start if any of them is malformed.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------

# Shown in the portal and used as the STIX identity name for the hosting ISAC.
AIVS_INSTANCE_NAME=Example Financial ISAC

# The base URL members reach this instance at. Used to build TAXII resource
# URLs, so it must be exactly what appears in their client configuration,
# including the scheme and any port. MUST be https:// -- the application
# refuses to start in production otherwise.
AIVS_PUBLIC_BASE_URL=https://aivs.example-isac.org

# Host address the proxy publishes port 443 on.
#   0.0.0.0        all interfaces (default; use only with a real allowlist)
#   10.88.0.1      the host's WireGuard overlay address -- RECOMMENDED, this
#                  makes AIVS unreachable from the public internet entirely
AIVS_BIND_ADDRESS=0.0.0.0

# INFO or WARNING. DEBUG is refused in production: debug logging can record
# request bodies, and those bodies are embargoed pre-CVE advisories.
AIVS_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# CA material
# -----------------------------------------------------------------------------

# ABSOLUTE path to deploy/ca/out -- the directory deploy/ca/init-ca.sh creates.
# It backs the aivs_ca_material named volume, which the proxy mounts read-only
# at /etc/nginx/ca. Relative paths do not work here: Docker resolves volume
# device paths against the daemon, not against your shell.
AIVS_CA_DIR=/opt/aivs/deploy/ca/out

# RFC 4514 subject DN of the issuing CA, e.g.
#   CN=Example Financial ISAC AIVS Issuing CA,OU=AIVS Certificate Authority,O=Example Financial ISAC,C=US
#
# Certificate registration refuses any certificate not issued by this CA, so the
# proxy's handshake verdict is not the only thing standing between a self-signed
# certificate and a registered identity. Read it after running init-ca.sh with:
#
#   openssl x509 -in deploy/ca/out/intermediate/intermediate.crt \
#     -noout -subject -nameopt rfc2253
#
# -nameopt rfc2253 emits the same reversed, comma-separated ordering that the
# application compares against, so the two strings match exactly.
AIVS_EXPECTED_CERTIFICATE_ISSUER_DN=

# -----------------------------------------------------------------------------
# Secrets
#
# GENERATE THESE. Do not invent them, do not reuse one for another, and do not
# copy them between environments.
#
#     openssl rand -base64 48
#
# Both must be at least 32 characters; the application validates this and
# refuses to start otherwise.
# -----------------------------------------------------------------------------

# Presented by the proxy in X-Proxy-Auth and compared by the application in
# constant time. This is the third of the three controls that stop a request
# from forging its own client identity. It is a bearer secret between two
# containers, so its only real threat is disclosure through this file --
# hence chmod 0600.
#
#     openssl rand -base64 48
#
# Deliberately too short to satisfy the 32-character minimum, and the literal
# REPLACE_ME is refused outright by Settings. An unedited value makes the
# application refuse to start rather than run on a secret published in this
# repository -- the placeholder used to be long enough to pass validation, and
# compose's ${VAR:?} guard only fires when a variable is unset or empty.
AIVS_PROXY_SHARED_SECRET=REPLACE_ME

# Signs portal session cookies, CSRF tokens and pagination cursors. Rotating it
# invalidates every active session, which is the correct response to a
# suspected leak.
#
#     openssl rand -base64 48
#
# Must be a DIFFERENT value from AIVS_PROXY_SHARED_SECRET above.
AIVS_SESSION_SECRET=REPLACE_ME

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

AIVS_DB_USER=aivs
AIVS_DB_NAME=aivs

# MUST BE URL-SAFE. This value is substituted into a DSN
# (postgresql+psycopg://user:PASSWORD@db:5432/name), so a raw '@', ':', '/' or
# '#' silently truncates the host or the database name and produces a
# connection error that looks nothing like a password problem.
#
#     openssl rand -base64 36 | tr '+/' '-_'
#
# Note that this is set only at first start: it is used by initdb to create the
# role. Changing it later requires ALTER ROLE in the database as well.
AIVS_DB_PASSWORD=REPLACE_ME

# -----------------------------------------------------------------------------
# Image pinning (optional but recommended for reviewed deployments)
#
# Leave unset to use the tags in docker-compose.yml. Set to the
# image@sha256:<digest> form so that the image a third-party risk review
# approved is byte-for-byte the image that runs. Obtain a digest with:
#
#     docker buildx imagetools inspect <image>:<tag> --format '{{.Manifest.Digest}}'
# -----------------------------------------------------------------------------

# AIVS_PROXY_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine@sha256:...
# AIVS_DB_IMAGE=postgres:16-alpine@sha256:...
# AIVS_APP_IMAGE=registry.example-isac.org/aivs-server:1.0.0@sha256:...
